# Copy to .env on the hosting server. Never publish this file or commit real secrets.
W2E_ENV=production
W2E_BASE_URL=https://your-domain.example
W2E_APP_SECRET=replace-with-at-least-64-random-hex-characters
W2E_DB_HOST=127.0.0.1
W2E_DB_PORT=3306
W2E_DB_NAME=what2eat
W2E_DB_USER=what2eat_app
W2E_DB_PASSWORD=replace-this
W2E_MAIL_FROM=What2Eat <no-reply@your-domain.example>
# Local development only: filename inside storage/ for captured verification/reset email.
W2E_DEV_MAIL_LOG=dev-mail.log
W2E_SUPPORT_EMAIL=
W2E_MAX_UPLOAD_BYTES=52428800
W2E_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
